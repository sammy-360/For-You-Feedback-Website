{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/for-you-feedback run build",
  "outputDirectory": "artifacts/for-you-feedback/dist/public",
  "functions": {
    "artifacts/for-you-feedback/api/**/*.ts": {
      "maxDuration": 10
    }
  }
}
